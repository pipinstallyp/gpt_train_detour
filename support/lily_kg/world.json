      "id": "single_color",
      "rule": "An object has at most one color in a scene. A known different color disproves the queried color."
    },
    {
      "id": "single_location",
      "rule": "An object is on at most one place in a scene. A known different place disproves the queried place."
    },
    {
      "id": "reach_composition",
      "rule": "If an object is on a place and an agent can/cannot reach that place, the agent can/cannot reach that object in this toy world."
    },
    {
      "id": "strict_weight_order",
      "rule": "Heavier is transitive and asymmetric. A reverse positive path disproves a heavier query."
    },
    {
      "id": "open_world",
      "rule": "A query with neither positive nor negative support is Unknown. Absence alone is not No."
